// program to count total even and odd number in array

#include <stdio.h>
void main()
{
    int a[5],i,even=0,odd=0;
    for(i=0;i<5;i++)
        {
            printf("enter array elements:%d",i+1);
            scanf("%d",&a[i]);
            
        }
    for(i=0;i<5;i++)
        { if(a[i]%2==0)
            even++;
          else
            odd++;
        }
    printf("%d%d",even,odd);
}
